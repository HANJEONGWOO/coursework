    "status": "implemented",
    "schema": "pa2-tp-service-quality-v1",
    "implementation": "tp_bridge.py:summarize_record and score_rubric.py; shared by local runs and grader",
    "formula": "A passing request earns 70 + 20*(1-max(TTFT/target, P95_ITL/target)) + 10*E; a failing request earns 0. E is the optimistic drain lower bound / actual drain.",
    "note": "Scores are derived from the same ASTRA events; no ranking, score stretching, or new inputs."
  },
